#version 460

#include "ShaderLayouts.h"
#include "ShaderFunctions.h"
#include "SmokeSpreadCommon.h"

layout (local_size_x = kiComputeTileSize, local_size_y = kiComputeTileSize) in;

// Uniforms
layout (set = 0, binding = kiGlobalBindingGlobalUniform) uniform globalUniform
{
	GlobalLayout globalLayout;
};

layout (set = 1, binding = 1) uniform sampler2D textureSampler;
layout (set = 1, binding = 2) uniform sampler2D noiseTextureSampler;
layout (set = 1, binding = 3) uniform sampler2D elevationTextureSampler;
layout (set = 1, binding = 4) uniform sampler2D windTextureSamplerOne;
layout (set = 1, binding = 5) uniform sampler2D windTextureSamplerTwo;
layout (set = 1, binding = 6, r16f) uniform writeonly image2D outputImage;

// Active tile list: [VkDispatchIndirectCommand (3 uint32s)] [packed tile indices...]
layout (set = 1, binding = 7) buffer activeTileBuffer
{
	uint uiDispatchX;
	uint uiDispatchY;
	uint uiDispatchZ;
	uint activeTiles[];
};

layout (set = 1, binding = 8) buffer occupancyBuffer
{
	uint occupancy[];
};

shared uint suHasSmoke;

void main()
{
	// Look up tile from active tile list
	uint uiTileIndex = activeTiles[gl_WorkGroupID.x];
	uint uiTilesX = globalLayout.uiSmokeTilesX;
	uint uiTileY = uiTileIndex / uiTilesX;
	uint uiTileX = uiTileIndex - uiTileY * uiTilesX;
	uint uiX = uiTileX * kiComputeTileSize + gl_LocalInvocationID.x;
	uint uiY = uiTileY * kiComputeTileSize + gl_LocalInvocationID.y;

	ivec2 i2Size = imageSize(outputImage);
	bool bInBounds = uiX < i2Size.x && uiY < i2Size.y;

	vec2 f2Texcoord = (vec2(uiX, uiY) + vec2(0.5f)) / vec2(i2Size);

	if (gl_LocalInvocationIndex == 0)
		suHasSmoke = 0;
	barrier();

	vec4 f4Result = vec4(0.0f);
	if (bInBounds)
	{
		// Pass-Two reads the previous frame's Pass-One output (plus deposits) at the same UV, still in
		// previous-area coords — the frame's single previous→current remap is Pass-One's job
		// — so input texcoord == output texcoord; the world
		// position for the elevation lookup uses current f4SmokeArea
		vec2 f2WorldPosition = VisibleAreaToWorld(f2Texcoord, globalLayout.f4SmokeArea);
		vec2 f2VisibleAreaTexcoord = WorldToVisibleArea(vec3(f2WorldPosition, 0.0f), globalLayout.f4VisibleArea);
		float fElevation = textureLod(elevationTextureSampler, f2VisibleAreaTexcoord, 0.0f).x;

		f4Result = SmokeSpread(globalLayout, textureSampler, noiseTextureSampler, windTextureSamplerOne, windTextureSamplerTwo, f2Texcoord, f2WorldPosition, f2Texcoord, globalLayout.fSmokeNoiseScaleTwo);

		// Extra decay over terrain
		if (fElevation > 0.0f)
		{
			// gSmokeDecay slider min 0.990 keeps pow() base > 0 -> always defined.
			f4Result.x *= pow(globalLayout.fSmokeDecay, max(1.0f, fElevation - 5.0f));
		}

		// Extra decay at edge of simulation area.
		// f2Texcoord is in [0, 1] by construction (texel center / imageSize) so the inner min(...) is non-negative; outer min clamps to 1.
		f4Result.x *= min(1.0f, globalLayout.fSmokeEdgeDecayDistanceInv * min(f2Texcoord.x, min(1.0f - f2Texcoord.x, min(f2Texcoord.y, 1.0f - f2Texcoord.y))));

		const float kfSmokeHalfMinSubnormal = 5.9604644775390625e-8f;
		const float kfSmokeHalfFixedPointDecay = 0.99951171875f;
		const float kfSmokeZeroThreshold = 0.0000001f;
		// kfSmokeHalfMinSubnormal is 2^-24; kfSmokeHalfFixedPointDecay is 1 - 2^-11.
		// These exact half-grid identities split the progress proof: the slow-decay branch steps one
		// positive half encoding, while the faster branch subtracts one minimum half quantum, so the
		// next R16 store is lower for every positive finite half input.
		if (globalLayout.fSmokeDecay >= kfSmokeHalfFixedPointDecay)
		{
			uint uiHalf = packHalf2x16(vec2(max(0.0f, f4Result.x), 0.0f)) & 0xffffu;
			uiHalf -= min(uiHalf, 1u);
			f4Result.x = unpackHalf2x16(uiHalf).x;
		}
		else
		{
			f4Result.x = max(0.0f, f4Result.x - kfSmokeHalfMinSubnormal);
		}
		if (f4Result.x < kfSmokeZeroThreshold)
			f4Result.x = 0.0f;

		imageStore(outputImage, ivec2(uiX, uiY), f4Result);
	}

	// Mark output tile in occupancy for next pass
	if (f4Result.x > 0.0f)
		atomicOr(suHasSmoke, 1u);
	barrier();

	if (gl_LocalInvocationIndex == 0 && suHasSmoke != 0)
	{
		uint uiOutTileIndex = uiTileY * uiTilesX + uiTileX;
		atomicOr(occupancy[uiOutTileIndex >> 5], 1u << (uiOutTileIndex & 31));
	}
}
