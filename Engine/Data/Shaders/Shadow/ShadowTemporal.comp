#version 460

#include "ShaderLayouts.h"
#include "ShaderFunctions.h"

layout (local_size_x = kiComputeTileSize, local_size_y = kiComputeTileSize) in;

// Uniforms
layout (set = 0, binding = kiGlobalBindingGlobalUniform) uniform globalUniform
{
    GlobalLayout globalLayout;
};

layout (set = 1, binding = 1) uniform sampler2D shadowHistorySampler;
layout (set = 1, binding = 2, r16) uniform image2D shadowBlurTexture; // keShadowFormat

// Temporal accumulation: blend the freshly-blurred shadow (in place) with the previous frame's result,
// reprojected into the current texel grid by world position. While the texel-ramp rescales the grid this
// averages out the per-frame resample jitter (an exponential moving average) so high-contrast edges stop
// flickering; at a settled grid history == current so it is a no-op.
void main()
{
	// The dispatch rounds the texture extent up to whole tiles, so the tail threads guard against it.
	ivec2 i2Texel = ivec2(gl_GlobalInvocationID.xy);
	if (any(greaterThanEqual(i2Texel, imageSize(shadowBlurTexture))))
		return;
	uint uiX = uint(i2Texel.x);
	uint uiY = uint(i2Texel.y);

	float fCurrent = imageLoad(shadowBlurTexture, ivec2(uiX, uiY)).x;

	// This texel's world position -> previous-frame UV. Reprojection makes the blend correct under pan/zoom
	// (the grid moves frame-to-frame). Disocclusion (reprojected UV outside [0,1] = newly revealed): keep current.
	vec2 f2Uv = (vec2(float(uiX), float(uiY)) + 0.5f) * globalLayout.f2ShadowTextureSizeInv;
	vec2 f2World = VisibleAreaToWorld(f2Uv, globalLayout.f4ShadowArea);
	vec2 f2PreviousUv = WorldToVisibleArea(vec3(f2World, 0.0f), globalLayout.f4ShadowAreaPrevious);

	float fBlended = fCurrent;
	if (globalLayout.fShadowTemporalBlend < 1.0f && all(greaterThanEqual(f2PreviousUv, vec2(0.0f))) && all(lessThanEqual(f2PreviousUv, vec2(1.0f))))
	{
		float fHistory = textureLod(shadowHistorySampler, f2PreviousUv, 0.0f).x;
		fBlended = mix(fHistory, fCurrent, globalLayout.fShadowTemporalBlend);
	}

	imageStore(shadowBlurTexture, ivec2(uiX, uiY), vec4(fBlended, 0.0f, 0.0f, 0.0f));
}
