#version 460

#include "ShaderLayouts.h"

layout (local_size_x = kiComputeTileSize, local_size_y = kiComputeTileSize) in;

// Uniforms
layout (set = 0, binding = kiGlobalBindingGlobalUniform) uniform globalUniform
{
    GlobalLayout globalLayout;
};

layout (set = 1, binding = 1) uniform sampler2D shadowBlurIntermediateSampler;
layout (set = 1, binding = 2, r16) uniform writeonly image2D shadowBlurTexture; // keShadowFormat

void main()
{
	uint uiX = gl_GlobalInvocationID.x;
	uint uiY = gl_GlobalInvocationID.y;

	// Compute the visible window + kiShadowWindowMargin so the consumer's bilinear edge reads land on
	// current-frame, fully-blurred texels.
	if (int(uiX) < globalLayout.iShadowVisibleMinX - kiShadowWindowMargin || int(uiX) >= globalLayout.iShadowVisibleMaxX + kiShadowWindowMargin ||
	    int(uiY) < globalLayout.iShadowVisibleMinY - kiShadowWindowMargin || int(uiY) >= globalLayout.iShadowVisibleMaxY + kiShadowWindowMargin)
		return;

	float fSigma = max(globalLayout.fShadowBlurSigma, 1e-6f);
	vec2 f2InvSize = 1.0f / vec2(globalLayout.fShadowTextureSizeWidth, globalLayout.fShadowTextureSizeHeight);
	float fTotal = 0.0f;
	float fWeightSum = 0.0f;
	for (int j = -kiShadowBlurRadius; j <= kiShadowBlurRadius; ++j)
	{
		float fA = float(j) / fSigma;
		float fWeight = exp(-0.5f * fA * fA);
		vec2 vUv = (vec2(float(uiX), float(int(uiY) + j)) + 0.5f) * f2InvSize;
		fTotal += fWeight * textureLod(shadowBlurIntermediateSampler, vUv, 0.0f).x;
		fWeightSum += fWeight;
	}

	imageStore(shadowBlurTexture, ivec2(uiX, uiY), vec4(fTotal / fWeightSum, 0.0f, 0.0f, 0.0f));
}
