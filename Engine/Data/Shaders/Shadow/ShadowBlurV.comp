#version 460

#include "ShaderLayouts.h"

layout (local_size_x = 8, local_size_y = kiShadowTextureExecutionSize) in;

// Uniforms
layout (binding = 0) uniform globalUniform
{
    GlobalLayout globalLayout;
};

layout (binding = 1) uniform sampler2D shadowBlurIntermediateSampler;
layout (binding = 2, r16) uniform image2D shadowBlurTexture;

void main()
{
	uint uiX = gl_GlobalInvocationID.x;
	uint uiY = gl_GlobalInvocationID.y;

	uint uiWidth = globalLayout.iShadowTextureWidth;
	uint uiHeight = globalLayout.iShadowTextureHeight;

	if (uiX >= uiWidth || uiY >= uiHeight)
		return;

	float fSigma = globalLayout.fShadowBlurSigma;

	const int iRadius = 5;
	float fInvSigma = float(iRadius) / fSigma;

	float fTotal = 0.0f;
	for (int j = -iRadius; j <= iRadius; ++j)
	{
		float fA = float(j) / fInvSigma;
		float fWeight = exp(-0.5f * fA * fA);
		vec2 vUv = vec2(float(uiX), float(int(uiY) + j)) / vec2(globalLayout.fShadowTextureSizeWidth, globalLayout.fShadowTextureSizeHeight);
		fTotal += fWeight * texture(shadowBlurIntermediateSampler, vUv).x;
	}

	imageStore(shadowBlurTexture, ivec2(uiX, uiY), vec4(fTotal, 0.0f, 0.0f, 0.0f));
}
