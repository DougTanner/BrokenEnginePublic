#version 460

#include "ShaderLayouts.h"
#include "ShaderFunctions.h"

layout (local_size_x = kiComputeTileSize, local_size_y = kiComputeTileSize) in;

layout (set = 0, binding = kiGlobalBindingGlobalUniform) uniform globalUniform
{
    GlobalLayout globalLayout;
};

layout (set = 1, binding = 1) uniform sampler2D elevationTextureSampler;
layout (set = 1, binding = 2, r16) uniform writeonly image2D shadowTexture; // keShadowFormat

void main()
{
	uint x = gl_GlobalInvocationID.x;
	uint y = gl_GlobalInvocationID.y;

	// Only the centered visible window (+ kiShadowWindowMargin) is ray-marched; outside writes the
	// unshadowed lit value (same as an in-window unshadowed texel) so the blur reads consistent edges.
	if (int(x) < globalLayout.iShadowVisibleMinX - kiShadowWindowMargin || int(x) >= globalLayout.iShadowVisibleMaxX + kiShadowWindowMargin ||
	    int(y) < globalLayout.iShadowVisibleMinY - kiShadowWindowMargin || int(y) >= globalLayout.iShadowVisibleMaxY + kiShadowWindowMargin)
	{
		imageStore(shadowTexture, ivec2(x, y), vec4(globalLayout.fShadowMoonMultiplier, 0.0, 0.0, 0.0));
		return;
	}

	vec2 f2InvElevationSize = 1.0f / vec2(globalLayout.fShadowElevationTextureSizeWidth, globalLayout.fShadowElevationTextureSizeHeight);

	float fElevation = max(textureLod(elevationTextureSampler, vec2(float(x) + float(globalLayout.iShadowStartOffset), float(y)) * f2InvElevationSize, 0.0f).x, 0.0f);

	float fSunAngle = globalLayout.fShadowSunAngle;
	vec3 f3ToBaseNormal = vec3(sign(globalLayout.fShadowDirectionMultiplier), 0.0f, 0.0f);

	float fDistance = globalLayout.fShadowDistanceFalloff;
	float fInvDistance = 1.0f / fDistance;

	float fShadow = 0.0f;
	float fOtherX = globalLayout.fShadowWidthScale;
	int iEnd = int(globalLayout.iShadowElevationSize);
	int iStart = int(x) + globalLayout.iShadowStartOffset + globalLayout.iShadowIncrement;
	for (int i = iStart; i != iEnd; i += globalLayout.iShadowIncrement, fOtherX += globalLayout.fShadowWidthScale)
	{
		float fAbsOtherX = abs(fOtherX);
		if (fAbsOtherX > fDistance)
		{
			break;
		}

		float fOtherElevation = max(textureLod(elevationTextureSampler, vec2(float(i), float(y)) * f2InvElevationSize, 0.0f).x, 0.0f);
		if (fOtherElevation <= fElevation)
		{
			continue;
		}

		float fDistanceFactor = fInvDistance * (fDistance - fAbsOtherX);
		if (fDistanceFactor < 0.01f)
		{
			break;
		}

		vec3 f3ToOtherNormal = normalize(vec3(fOtherX, 0.0, fOtherElevation - fElevation));
		float fTerrainAngle = acos(clamp(dot(f3ToBaseNormal, f3ToOtherNormal), -1.0f, 1.0f));

		float fFeather = globalLayout.fShadowFeather;
		float fHeightMultiplier = clamp((fOtherElevation - globalLayout.fShadowHeightFadeBottom) / (globalLayout.fShadowHeightFadeTop - globalLayout.fShadowHeightFadeBottom), 0.0f, 1.0f);
		fShadow = max(fHeightMultiplier * fDistanceFactor * mix(1.0f, 0.0f, (fSunAngle - fTerrainAngle + globalLayout.fShadowNoonOffset + globalLayout.fShadowSunsetOffset) * fFeather), fShadow);
		if (fShadow >= 1.0f)
		{
			break;
		}
	}

	imageStore(shadowTexture, ivec2(x, y), vec4((1.0f - fShadow) * globalLayout.fShadowMoonMultiplier, 0.0, 0.0, 0.0));
}
