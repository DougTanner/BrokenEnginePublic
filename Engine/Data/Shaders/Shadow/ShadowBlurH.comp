#version 460

#include "ShaderLayouts.h"

layout (local_size_x = kiComputeTileSize, local_size_y = kiComputeTileSize) in;

// Uniforms
layout (binding = 0) uniform globalUniform
{
    GlobalLayout globalLayout;
};

layout (binding = 1) uniform sampler2D shadowTextureSampler;
layout (binding = 2, r16) uniform writeonly image2D shadowBlurIntermediateTexture;

void main()
{
	uint uiX = gl_GlobalInvocationID.x;
	uint uiY = gl_GlobalInvocationID.y;

	uint uiWidth = globalLayout.iShadowTextureWidth;
	uint uiHeight = globalLayout.iShadowTextureHeight;

	if (uiX >= uiWidth || uiY >= uiHeight)
		return;

	float fSigma = max(globalLayout.fShadowBlurSigma, 1e-6f);
	vec2 f2InvSize = 1.0f / vec2(globalLayout.fShadowTextureSizeWidth, globalLayout.fShadowTextureSizeHeight);

	const int iRadius = 5;
	float fTotal = 0.0f;
	float fWeightSum = 0.0f;
	for (int i = -iRadius; i <= iRadius; ++i)
	{
		float fA = float(i) / fSigma;
		float fWeight = exp(-0.5f * fA * fA);
		vec2 vUv = (vec2(float(int(uiX) + i), float(uiY)) + 0.5f) * f2InvSize;
		fTotal += fWeight * textureLod(shadowTextureSampler, vUv, 0.0f).x;
		fWeightSum += fWeight;
	}

	imageStore(shadowBlurIntermediateTexture, ivec2(uiX, uiY), vec4(fTotal / fWeightSum, 0.0f, 0.0f, 0.0f));
}
