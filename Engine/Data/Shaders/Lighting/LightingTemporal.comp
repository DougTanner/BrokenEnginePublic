#version 460

#include "ShaderLayouts.h"
#include "ShaderFunctions.h"

layout (local_size_x = kiComputeTileSize, local_size_y = kiComputeTileSize) in;

// Uniforms
layout (set = 0, binding = kiGlobalBindingGlobalUniform) uniform globalUniform
{
	GlobalLayout globalLayout;
};

// 4 history samplers (previous-frame combine outputs) + 4 combine storage images (read-write, blended in place).
layout (set = 1, binding = 1) uniform sampler2D historyR;
layout (set = 1, binding = 2) uniform sampler2D historyG;
layout (set = 1, binding = 3) uniform sampler2D historyB;
layout (set = 1, binding = 4) uniform sampler2D historyAmbient;
layout (set = 1, binding = 5, rgba8) uniform image2D combineImageR; // keCombineFormat
layout (set = 1, binding = 6, rgba8) uniform image2D combineImageG; // keCombineFormat
layout (set = 1, binding = 7, rgba8) uniform image2D combineImageB; // keCombineFormat
layout (set = 1, binding = 8, rgba8) uniform image2D combineImageAmbient; // keCombineFormat

// Temporal accumulation: blend the freshly-combined lighting (in place) with the previous frame's result,
// reprojected into the current texel grid by world position. While the texel-ramp rescales the grid this
// averages out the per-frame resample jitter (an exponential moving average) so it stops flickering; at a
// settled grid history == current so it is a no-op. Mirror of ShadowTemporal.comp over the four combine outputs.
void main()
{
	// The dispatch rounds the texture extent up to whole tiles, so the tail threads guard against it.
	ivec2 i2Size = imageSize(combineImageR);
	ivec2 i2Coord = ivec2(gl_GlobalInvocationID.xy);
	if (any(greaterThanEqual(i2Coord, i2Size)))
		return;
	float fBlend = globalLayout.fLightingTemporalBlend;
	if (fBlend >= 1.0f)
		return;

	vec2 f2Uv = (vec2(i2Coord) + 0.5f) / vec2(i2Size);
	vec2 f2World = VisibleAreaToWorld(f2Uv, globalLayout.f4LightingArea);

	// This texel's world position -> previous-frame UV. Disocclusion (reprojected UV outside [0,1] = newly
	// revealed): keep current (the history fetch would be off-grid / stale).
	vec2 f2PreviousUv = WorldToVisibleArea(vec3(f2World, 0.0f), globalLayout.f4LightingAreaPrevious);
	if (any(lessThan(f2PreviousUv, vec2(0.0f))) || any(greaterThan(f2PreviousUv, vec2(1.0f))))
		return;

	imageStore(combineImageR, i2Coord, mix(textureLod(historyR, f2PreviousUv, 0.0f), imageLoad(combineImageR, i2Coord), fBlend));
	imageStore(combineImageG, i2Coord, mix(textureLod(historyG, f2PreviousUv, 0.0f), imageLoad(combineImageG, i2Coord), fBlend));
	imageStore(combineImageB, i2Coord, mix(textureLod(historyB, f2PreviousUv, 0.0f), imageLoad(combineImageB, i2Coord), fBlend));
	imageStore(combineImageAmbient, i2Coord, mix(textureLod(historyAmbient, f2PreviousUv, 0.0f), imageLoad(combineImageAmbient, i2Coord), fBlend));
}
