#version 460

#extension GL_EXT_nonuniform_qualifier : require

#include "ShaderLayouts.h"

layout (local_size_x = kiComputeTileSize, local_size_y = kiComputeTileSize) in;

// Uniforms
layout (binding = 0) uniform globalUniform
{
	GlobalLayout globalLayout;
};

layout (binding = 1) uniform sampler2D cascadeSamplers[8];
layout (binding = 2, rgba16f) uniform writeonly image2D outputImage;

layout (push_constant) uniform PushConstants
{
	uint uiOutputWidth;
	uint uiOutputHeight;
};

void main()
{
	uint uiX = gl_GlobalInvocationID.x;
	uint uiY = gl_GlobalInvocationID.y;

	if (uiX >= uiOutputWidth || uiY >= uiOutputHeight)
		return;

	vec2 f2Uv = (vec2(gl_GlobalInvocationID.xy) + 0.5f) / vec2(uiOutputWidth, uiOutputHeight);

	vec4 f4Accumulated = vec4(0.0f);
	float fWeight = 1.0f;
	float fDecay = globalLayout.fLightingCombineDecay;
	uint uiCascadeCount = globalLayout.uiLightCascadeCount;

	// Combine from cascade levels (highest to lowest) then first spread (index 0)
	for (uint i = uiCascadeCount; i > 0; i--)
	{
		f4Accumulated += texture(cascadeSamplers[nonuniformEXT(i)], f2Uv) * fWeight;
		fWeight *= fDecay;
	}

	// Index 0: first spread (not deposit)
	f4Accumulated += texture(cascadeSamplers[0], f2Uv) * fWeight;

	f4Accumulated *= globalLayout.fLightingTimeOfDayMultiplier;

	imageStore(outputImage, ivec2(uiX, uiY), f4Accumulated);
}
