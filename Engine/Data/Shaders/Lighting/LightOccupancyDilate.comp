#version 460

#include "ShaderLayouts.h"

layout (local_size_x = kiOccupancyDilateGroupSize) in;

// Uniforms
layout (binding = 0) uniform globalUniform
{
	GlobalLayout globalLayout;
};

layout (binding = 1) buffer occupancyBuffer
{
	uint occupancy[];
};

layout (push_constant) uniform PushConstants
{
	uint uiTilesX;
	uint uiTilesY;
	uint uiOccupancyDilation;
};

void main()
{
	uint uiTotalTiles = uiTilesX * uiTilesY;
	uint uiTileIndex = gl_GlobalInvocationID.x;
	if (uiTileIndex >= uiTotalTiles)
		return;

	// Check if this tile is already occupied
	if ((occupancy[uiTileIndex >> 5] & (1u << (uiTileIndex & 31))) == 0u)
		return;

	uint uiTileY = uiTileIndex / uiTilesX;
	uint uiTileX = uiTileIndex - uiTileY * uiTilesX;

	int iRadius = int(uiOccupancyDilation);

	// Grow: mark all neighbors within radius
	for (int iDy = -iRadius; iDy <= iRadius; ++iDy)
	{
		for (int iDx = -iRadius; iDx <= iRadius; ++iDx)
		{
			if (iDx == 0 && iDy == 0)
				continue;

			int iNx = int(uiTileX) + iDx;
			int iNy = int(uiTileY) + iDy;
			if (iNx < 0 || iNy < 0 || uint(iNx) >= uiTilesX || uint(iNy) >= uiTilesY)
				continue;

			uint uiNeighborIndex = uint(iNy) * uiTilesX + uint(iNx);
			atomicOr(occupancy[uiNeighborIndex >> 5], 1u << (uiNeighborIndex & 31));
		}
	}
}
