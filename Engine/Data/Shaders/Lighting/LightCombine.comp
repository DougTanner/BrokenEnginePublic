#version 460

#include "ShaderLayouts.h"

layout (local_size_x = kiComputeTileSize, local_size_y = kiComputeTileSize) in;

layout (binding = 0) uniform globalUniform
{
	GlobalLayout globalLayout;
};

layout (binding = 1) uniform sampler2D sourcesR[kiMaxSpreadPasses];
layout (binding = 2) uniform sampler2D sourcesG[kiMaxSpreadPasses];
layout (binding = 3) uniform sampler2D sourcesB[kiMaxSpreadPasses];
layout (binding = 4, rgba8) uniform writeonly image2D combineImageR;
layout (binding = 5, rgba8) uniform writeonly image2D combineImageG;
layout (binding = 6, rgba8) uniform writeonly image2D combineImageB;

layout (push_constant) uniform PushConstants
{
	uint uiWidth;
	uint uiHeight;
};

void main()
{
	uint uiX = gl_GlobalInvocationID.x;
	uint uiY = gl_GlobalInvocationID.y;
	if (uiX >= uiWidth || uiY >= uiHeight)
		return;

	vec2 f2Uv = (vec2(uiX, uiY) + vec2(0.5f)) / vec2(uiWidth, uiHeight);
	ivec2 i2Coord = ivec2(uiX, uiY);

	float fPassCount = globalLayout.fSpreadPassCount;
	uint uiPassCount = uint(fPassCount);

	float fPassNorm = mix(1.0f, 1.0f / fPassCount, globalLayout.fCombinePassNormalize);
	float fPassScale = pow(fPassCount, -globalLayout.fCombineExposurePassScale);

	vec4 f4R = texture(sourcesR[uiPassCount - 1], f2Uv) * fPassNorm * fPassScale;
	vec4 f4G = texture(sourcesG[uiPassCount - 1], f2Uv) * fPassNorm * fPassScale;
	vec4 f4B = texture(sourcesB[uiPassCount - 1], f2Uv) * fPassNorm * fPassScale;

#if 0 // Luminance-based Reinhard — preserves color ratios across RGB channels
	float fLumR = dot(f4R, vec4(1.0f));
	float fLumG = dot(f4G, vec4(1.0f));
	float fLumB = dot(f4B, vec4(1.0f));
	float fLum = max(fLumR + fLumG + fLumB, 0.001f);
	float fToneMapped = fLum / (1.0f + fLum);
	float fScale = fToneMapped / fLum;
	f4R *= fScale;
	f4G *= fScale;
	f4B *= fScale;
#else // Per-channel Reinhard
	f4R = f4R / (vec4(1.0f) + f4R);
	f4G = f4G / (vec4(1.0f) + f4G);
	f4B = f4B / (vec4(1.0f) + f4B);
#endif

	// Weighted sum of 3 power curves
	float fI1 = globalLayout.fCombineIntensityOne;
	float fI2 = globalLayout.fCombineIntensityTwo;
	float fI3 = globalLayout.fCombineIntensityThree;
	vec4 f4P1 = vec4(globalLayout.fCombinePowerOne);
	vec4 f4P2 = vec4(globalLayout.fCombinePowerTwo);
	vec4 f4P3 = vec4(globalLayout.fCombinePowerThree);

	imageStore(combineImageR, i2Coord, fI1 * pow(f4R, f4P1) + fI2 * pow(f4R, f4P2) + fI3 * pow(f4R, f4P3));
	imageStore(combineImageG, i2Coord, fI1 * pow(f4G, f4P1) + fI2 * pow(f4G, f4P2) + fI3 * pow(f4G, f4P3));
	imageStore(combineImageB, i2Coord, fI1 * pow(f4B, f4P1) + fI2 * pow(f4B, f4P2) + fI3 * pow(f4B, f4P3));
}
