#version 460

#include "ShaderLayouts.h"

layout (local_size_x = kiComputeTileSize, local_size_y = kiComputeTileSize) in;

layout (binding = 0) uniform globalUniform
{
	GlobalLayout globalLayout;
};

layout (binding = 1) uniform sampler2D sourcesR[kiMaxSpreadPasses];
layout (binding = 2) uniform sampler2D sourcesG[kiMaxSpreadPasses];
layout (binding = 3) uniform sampler2D sourcesB[kiMaxSpreadPasses];
layout (binding = 4, rgba8) uniform writeonly image2D combineImageR;
layout (binding = 5, rgba8) uniform writeonly image2D combineImageG;
layout (binding = 6, rgba8) uniform writeonly image2D combineImageB;

layout (push_constant) uniform PushConstants
{
	uint uiWidth;
	uint uiHeight;
};

// Uchimura tone curve (Gran Turismo Sport)
// P: max brightness, a: contrast, m: linear start, l: linear length, c: toe curvature, b: black tightness
vec4 Uchimura(vec4 f4X, float P, float a, float m, float l, float c, float b)
{
	float l0 = ((P - m) * l) / a;
	float S0 = m + l0;
	float S1 = m + a * l0;
	float C2 = (a * P) / (P - S1);
	float CP = -C2 / P;

	vec4 f4W0 = vec4(1.0f) - smoothstep(vec4(0.0f), vec4(m), f4X);
	vec4 f4W2 = step(vec4(S0), f4X);
	vec4 f4W1 = vec4(1.0f) - f4W0 - f4W2;

	vec4 f4T = m * pow(f4X / m, vec4(c)) + b;
	vec4 f4L = m + a * (f4X - m);
	vec4 f4S = P - (P - S1) * exp(CP * (f4X - S0));

	return f4T * f4W0 + f4L * f4W1 + f4S * f4W2;
}

float UchimuraScalar(float fX, float P, float a, float m, float l, float c, float b)
{
	float l0 = ((P - m) * l) / a;
	float S0 = m + l0;
	float S1 = m + a * l0;
	float C2 = (a * P) / (P - S1);
	float CP = -C2 / P;

	float fW0 = 1.0f - smoothstep(0.0f, m, fX);
	float fW2 = step(S0, fX);
	float fW1 = 1.0f - fW0 - fW2;

	float fT = m * pow(fX / m, c) + b;
	float fL = m + a * (fX - m);
	float fS = P - (P - S1) * exp(CP * (fX - S0));

	return fT * fW0 + fL * fW1 + fS * fW2;
}

void main()
{
	uint uiX = gl_GlobalInvocationID.x;
	uint uiY = gl_GlobalInvocationID.y;
	if (uiX >= uiWidth || uiY >= uiHeight)
		return;

	vec2 f2Uv = (vec2(uiX, uiY) + vec2(0.5f)) / vec2(uiWidth, uiHeight);
	ivec2 i2Coord = ivec2(uiX, uiY);

	float fPassCount = globalLayout.fSpreadPassCount;
	uint uiPassCount = uint(fPassCount);

	float fPassNorm = mix(1.0f, 1.0f / fPassCount, globalLayout.fCombinePassNormalize);
	float fPassScale = pow(fPassCount, -globalLayout.fCombineExposurePassScale);

	vec4 f4R = texture(sourcesR[uiPassCount - 1], f2Uv) * fPassNorm * fPassScale;
	vec4 f4G = texture(sourcesG[uiPassCount - 1], f2Uv) * fPassNorm * fPassScale;
	vec4 f4B = texture(sourcesB[uiPassCount - 1], f2Uv) * fPassNorm * fPassScale;

	float P = globalLayout.fCombineMaxBrightness;
	float a = globalLayout.fCombineContrast;
	float m = globalLayout.fCombineLinearStart;
	float l = globalLayout.fCombineLinearLength;
	float c = globalLayout.fCombineToe;
	float b = globalLayout.fCombineBlackTightness;

	float fHuePreserve = globalLayout.fCombineHuePreserve;
	if (fHuePreserve < 0.001f)
	{
		imageStore(combineImageR, i2Coord, Uchimura(f4R, P, a, m, l, c, b));
		imageStore(combineImageG, i2Coord, Uchimura(f4G, P, a, m, l, c, b));
		imageStore(combineImageB, i2Coord, Uchimura(f4B, P, a, m, l, c, b));
	}
	else
	{
		vec4 f4OutR = Uchimura(f4R, P, a, m, l, c, b);
		vec4 f4OutG = Uchimura(f4G, P, a, m, l, c, b);
		vec4 f4OutB = Uchimura(f4B, P, a, m, l, c, b);

		// Hue-preserving: per-EWNS-direction, tone-map luminance scalar, scale all channels by ratio
		vec4 f4HueR = f4R;
		vec4 f4HueG = f4G;
		vec4 f4HueB = f4B;
		for (int i = 0; i < 4; i++)
		{
			float fLum = 0.2126f * f4R[i] + 0.7152f * f4G[i] + 0.0722f * f4B[i];
			float fMappedLum = UchimuraScalar(fLum, P, a, m, l, c, b);
			float fRatio = fMappedLum / max(fLum, 0.001f);
			f4HueR[i] = f4R[i] * fRatio;
			f4HueG[i] = f4G[i] * fRatio;
			f4HueB[i] = f4B[i] * fRatio;
		}

		imageStore(combineImageR, i2Coord, mix(f4OutR, f4HueR, fHuePreserve));
		imageStore(combineImageG, i2Coord, mix(f4OutG, f4HueG, fHuePreserve));
		imageStore(combineImageB, i2Coord, mix(f4OutB, f4HueB, fHuePreserve));
	}
}
