#version 460

#include "ShaderLayouts.h"
#include "ShaderFunctions.h"

layout (local_size_x = kiComputeTileSize, local_size_y = kiComputeTileSize) in;

layout (set = 0, binding = kiGlobalBindingGlobalUniform) uniform globalUniform
{
	GlobalLayout globalLayout;
};

layout (set = 1, binding = 1) uniform sampler2D sourcesR[kiMaxSpreadPasses];
layout (set = 1, binding = 2) uniform sampler2D sourcesG[kiMaxSpreadPasses];
layout (set = 1, binding = 3) uniform sampler2D sourcesB[kiMaxSpreadPasses];
layout (set = 1, binding = 4, rgba8) uniform writeonly image2D combineImageR; // keCombineFormat
layout (set = 1, binding = 5, rgba8) uniform writeonly image2D combineImageG; // keCombineFormat
layout (set = 1, binding = 6, rgba8) uniform writeonly image2D combineImageB; // keCombineFormat
layout (set = 1, binding = 7, rgba8) uniform writeonly image2D combineImageAmbient; // keCombineFormat

// Uchimura tone curve (Gran Turismo Sport)
// P: max brightness, a: contrast, m: linear start, c: toe curvature, b: black tightness. The segment constants
// S0/S1/CP are precomputed on the CPU from those inputs plus linear-length (globalLayout.fCombineS0/S1/CP).
vec4 Uchimura(vec4 f4X)
{
	float P = globalLayout.fCombineMaxBrightness;
	float a = globalLayout.fCombineContrast;
	float m = globalLayout.fCombineLinearStart;
	float c = globalLayout.fCombineToe;
	float b = globalLayout.fCombineBlackTightness;
	float S0 = globalLayout.fCombineS0;
	float S1 = globalLayout.fCombineS1;
	float CP = globalLayout.fCombineCP;

	vec4 f4W0 = vec4(1.0f) - smoothstep(vec4(0.0f), vec4(m), f4X);
	vec4 f4W2 = step(vec4(S0), f4X);
	vec4 f4W1 = vec4(1.0f) - f4W0 - f4W2;

	// Clamp pow base — sum of float16 EWNS textures can have tiny negative residuals after bilinear filtering, mirroring DebugTexture.frag
	vec4 f4T = m * pow(max(f4X, vec4(0.0f)) / m, vec4(c)) + b;
	vec4 f4L = m + a * (f4X - m);
	vec4 f4S = P - (P - S1) * exp(CP * (f4X - S0));

	return f4T * f4W0 + f4L * f4W1 + f4S * f4W2;
}

float UchimuraScalar(float fX)
{
	float P = globalLayout.fCombineMaxBrightness;
	float a = globalLayout.fCombineContrast;
	float m = globalLayout.fCombineLinearStart;
	float c = globalLayout.fCombineToe;
	float b = globalLayout.fCombineBlackTightness;
	float S0 = globalLayout.fCombineS0;
	float S1 = globalLayout.fCombineS1;
	float CP = globalLayout.fCombineCP;

	float fW0 = 1.0f - smoothstep(0.0f, m, fX);
	float fW2 = step(S0, fX);
	float fW1 = 1.0f - fW0 - fW2;

	float fT = m * pow(max(fX, 0.0f) / m, c) + b;
	float fL = m + a * (fX - m);
	float fS = P - (P - S1) * exp(CP * (fX - S0));

	return fT * fW0 + fL * fW1 + fS * fW2;
}

void main()
{
	// The dispatch rounds the texture extent up to whole tiles, so the tail threads guard against it.
	ivec2 i2Coord = ivec2(gl_GlobalInvocationID.xy);
	if (any(greaterThanEqual(i2Coord, imageSize(combineImageR))))
		return;

	vec2 f2Uv = (vec2(i2Coord) + vec2(0.5f)) / vec2(imageSize(combineImageR));

	float fPassCount = globalLayout.fSpreadPassCount;
	uint uiPassCount = uint(fPassCount);

	vec4 f4R = vec4(0.0f);
	vec4 f4G = vec4(0.0f);
	vec4 f4B = vec4(0.0f);
	for (uint i = 0u; i < uiPassCount; ++i)
	{
		f4R += texture(sourcesR[i], f2Uv);
		f4G += texture(sourcesG[i], f2Uv);
		f4B += texture(sourcesB[i], f2Uv);
	}
	f4R *= globalLayout.fCombinePassTotalScale;
	f4G *= globalLayout.fCombinePassTotalScale;
	f4B *= globalLayout.fCombinePassTotalScale;

	vec4 f4FinalR;
	vec4 f4FinalG;
	vec4 f4FinalB;
	float fHuePreserve = globalLayout.fCombineHuePreserve;
	if (fHuePreserve < 0.001f)
	{
		f4FinalR = Uchimura(f4R);
		f4FinalG = Uchimura(f4G);
		f4FinalB = Uchimura(f4B);
	}
	else
	{
		// Hue-preserving: per-EWNS-direction, tone-map luminance scalar, scale all channels by ratio
		vec4 f4HueR = f4R;
		vec4 f4HueG = f4G;
		vec4 f4HueB = f4B;
		for (int i = 0; i < 4; i++)
		{
			float fLum = dot(vec3(f4R[i], f4G[i], f4B[i]), kRec709);
			float fMappedLum = UchimuraScalar(fLum);
			float fRatio = fMappedLum / max(fLum, 0.001f);
			f4HueR[i] = f4R[i] * fRatio;
			f4HueG[i] = f4G[i] * fRatio;
			f4HueB[i] = f4B[i] * fRatio;
		}

		if (fHuePreserve < 0.999f)
		{
			// Blend the per-channel Uchimura result toward the hue-preserving result (mirror of the < 0.001f fast path)
			f4FinalR = mix(Uchimura(f4R), f4HueR, fHuePreserve);
			f4FinalG = mix(Uchimura(f4G), f4HueG, fHuePreserve);
			f4FinalB = mix(Uchimura(f4B), f4HueB, fHuePreserve);
		}
		else
		{
			// fHuePreserve ~= 1: the mix would return the hue-preserving result, so skip the three Uchimura calls
			f4FinalR = f4HueR;
			f4FinalG = f4HueG;
			f4FinalB = f4HueB;
		}
	}

	imageStore(combineImageR, i2Coord, f4FinalR);
	imageStore(combineImageG, i2Coord, f4FinalG);
	imageStore(combineImageB, i2Coord, f4FinalB);
	// The ambient target stores the AVERAGE of the four EWNS channels (0.25 * (E+W+N+S)) per color channel, so
	// consumers do one sample instead of three. Consumers needing the un-averaged sum multiply by 4:
	// Water/Water.frag and Terrain/Terrain.frag pass 4.0f * f3AmbientSum into BlendSmokePrecomputed. Changing this
	// 0.25f means changing both of those call sites in the same edit.
	imageStore(combineImageAmbient, i2Coord, vec4(dot(f4FinalR, vec4(0.25f)), dot(f4FinalG, vec4(0.25f)), dot(f4FinalB, vec4(0.25f)), 1.0f));
}
