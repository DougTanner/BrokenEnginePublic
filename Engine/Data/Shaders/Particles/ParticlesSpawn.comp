#version 460

#include "ShaderLayouts.h"
#include "ShaderFunctions.h"

// Sequential free-list scan — single-threaded by design; parallel claim would require subgroup ballot
layout (local_size_x = 1) in;

layout (binding = 0) uniform globalUniform
{
    GlobalLayout globalLayout;
};

layout (scalar, binding = 1) buffer spawnUniform
{
	ParticlesSpawnLayout spawn;
};

layout (scalar, binding = 2) buffer particlesUniform
{
	ParticlesLayout particles;
};

layout (scalar, binding = 3) buffer dispatchIndirectCommandUniform
{
	VkDispatchIndirectCommand vkDispatchIndirectCommand;
};

layout (scalar, binding = 4) buffer drawIndirectCommandUniform
{
	VkDrawIndexedIndirectCommand vkDrawIndexedIndirectCommand;
};

void main()
{
	// Reset?
	if (spawn.iReset == 1)
	{
		particles.iLastCount = 0;
		particles.iMinFreeIndex = 0;
		particles.fLastUpdateTime = globalLayout.fElapsedTime;
		// PERF: single-thread full-buffer clear; vkCmdFillBuffer or parallel clear dispatch would be faster
		for (int i = 0; i < kiMaxParticles; ++i)
		{
		#if defined(ENABLE_32_BIT_BOOL)
			particles.puiAllocated[i / 32] &= ~(1u << (uint(i) % 32u));
		#else
			// Header declares pbAllocated as uint16_t; dead branch under ENABLE_32_BIT_BOOL but keep types reconciled
			particles.pbAllocated[i] = uint16_t(0);
		#endif
		}

		vkDispatchIndirectCommand.x = 0;
		vkDispatchIndirectCommand.y = 0;
		vkDispatchIndirectCommand.z = 0;

		vkDrawIndexedIndirectCommand.indexCount = 0;
		vkDrawIndexedIndirectCommand.instanceCount = 0;
		vkDrawIndexedIndirectCommand.firstIndex = 0;
		vkDrawIndexedIndirectCommand.vertexOffset = 0;
		vkDrawIndexedIndirectCommand.firstInstance = 0;

		return;
	}

	// Copy the particles in the spawn buffer into the particle buffer
#if defined(ENABLE_SHADER_REALTIME_CLOCK_EXT)
	uint64_t uiStartTime = clockRealtimeEXT();
#endif
	if (spawn.iCount > 0)
	{
		int32_t iSpawnIndex = 0;
		for (int32_t i = particles.iMinFreeIndex; i < kiMaxParticles; ++i)
		{
		#if defined(ENABLE_32_BIT_BOOL)
			if ((particles.puiAllocated[i / 32] & (1u << (uint(i) % 32u))) == 0)
		#else
			if (particles.pbAllocated[i] == 0)
		#endif
			{
				particles.iMinFreeIndex = i + 1;

			#if defined(ENABLE_32_BIT_BOOL)
				particles.puiAllocated[i / 32] |= 1u << (uint(i) % 32u);
			#else
				particles.pbAllocated[i] = uint16_t(1);
			#endif
				particles.pParticles[i] = spawn.pParticles[iSpawnIndex++];
				particles.iLastCount = max(particles.iLastCount, i + 1);
				if (iSpawnIndex == spawn.iCount)
				{
					break;
				}
			}
		}
	}
#if defined(ENABLE_SHADER_REALTIME_CLOCK_EXT)
	uint64_t uiEndTime = clockRealtimeEXT();
	debugPrintfEXT("Spawn: %d (%lu)", spawn.iCount, (uiEndTime - uiStartTime) / 1000);
#endif

	// Calculate the time since the last update, this value will be used by ParticlesUpdate
	float fCurrentTime = globalLayout.fElapsedTime;
	particles.fDeltaTime = max(0.0f, fCurrentTime - particles.fLastUpdateTime);
	particles.fLastUpdateTime = fCurrentTime;

	// Update 'count'
	int32_t iCount = 0;
	for (int32_t i = particles.iLastCount - 1; i >= 0; --i)
	{
	#if defined(ENABLE_32_BIT_BOOL)
		if ((particles.puiAllocated[i / 32] & (1u << (uint(i) % 32u))) != 0)
	#else
		if (particles.pbAllocated[i] == 1)
	#endif
		{
			iCount = i + 1;
			break;
		}
	}
	particles.iLastCount = iCount;

	// Fill in the dispatch command that will control the ParticlesUpdate compute shader
	// ParticlesUpdate's local_size_x is kiParticleUpdateGroupSize, so dispatch ceil(particle_count / group size)
	vkDispatchIndirectCommand.x = (particles.iLastCount + (kiParticleUpdateGroupSize - 1)) / kiParticleUpdateGroupSize;
	vkDispatchIndirectCommand.y = 1;
	vkDispatchIndirectCommand.z = 1;

	// Fill in the draw command that will control the ParticlesRender vertex shader
	vkDrawIndexedIndirectCommand.indexCount = 6;
	vkDrawIndexedIndirectCommand.instanceCount = particles.iLastCount;
	vkDrawIndexedIndirectCommand.firstIndex = 0;
	vkDrawIndexedIndirectCommand.vertexOffset = 0;
	vkDrawIndexedIndirectCommand.firstInstance = 0;
}
