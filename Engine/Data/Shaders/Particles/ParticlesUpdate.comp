#version 460

#include "ShaderLayouts.h"
#include "ShaderFunctions.h"

layout (local_size_x = kiParticleUpdateGroupSize) in;

layout (binding = 0) uniform globalUniform
{
    GlobalLayout globalLayout;
};

layout (scalar, binding = 1) buffer particlesUniform
{
	ParticlesLayout particles;
};

layout (binding = 2) uniform sampler2D elevationTextureSampler;

void main()
{
	int i = int32_t(gl_GlobalInvocationID.x);

	// Bounds check for parallelized dispatch (workgroup size = 32)
	if (i >= particles.iLastCount)
	{
		return;
	}

#if defined(ENABLE_32_BIT_BOOL)
	if ((particles.puiAllocated[i / 32] & (1u << (uint(i) % 32u))) == 0u)
#else
	if (particles.pbAllocated[i] == 0)
#endif
	{
		return;
	}

	float fDeltaTime = particles.fDeltaTime;

	// Hoist read-only / read-write fields into individual locals (stylistic, not a workaround — the
	// previously-claimed glslang trailing-field-drop on scalar-block-layout SSBO copies was investigated
	// and not substantiated; a whole-struct copy would be equally valid)
	const float fGravity = particles.pParticles[i].fGravity;
	const float fVelocityDecay = particles.pParticles[i].fVelocityDecay;
	const float fIntensityDecay = particles.pParticles[i].fIntensityDecay;
	const float fSizeDecay = particles.pParticles[i].fSizeDecay;
	const float fRotationDelta = particles.pParticles[i].fRotationDelta;
	const float fRotationDeltaDecay = particles.pParticles[i].fRotationDeltaDecay;

	vec4 f4OriginalPosition = particles.pParticles[i].f4Position;
	vec4 f4Velocity = particles.pParticles[i].f4Velocity;
	float fVisibleIntensity = particles.pParticles[i].fVisibleIntensity;
	float fSize = particles.pParticles[i].fSize;
	float fLength = particles.pParticles[i].fLength;
	float fRotation = particles.pParticles[i].fRotation;

	// Position integration — xyz only so the W invariant (Position.w=1, Velocity.w=0) is preserved bit-exact
	vec4 f4Position = vec4(f4OriginalPosition.xyz + fDeltaTime * f4Velocity.xyz, f4OriginalPosition.w);

	// Capture pre-collision z for the "kill on water hit" death test — survives the snap-to-terrain mutation below
	float fPreCollisionZ = f4Position.z;

	vec2 f2VisibleAreaTexcoord = WorldToVisibleArea(f4Position.xyz, globalLayout.f4VisibleArea);
	float fTerrainElevation = textureLod(elevationTextureSampler, f2VisibleAreaTexcoord, 0.0f).x;
	if (f4Position.z < fTerrainElevation)
	{
		// Snap z to terrain surface and flip z-velocity for next frame — avoids energy gain from re-integrating a full dt step
		f4Velocity.z = abs(f4Velocity.z);
		f4Position.z = fTerrainElevation;
	}
	else
	{
		// Gravity
		f4Velocity.z -= fDeltaTime * fGravity;
	}

	// Velocity decay
	f4Velocity *= (1.0f - fDeltaTime * fVelocityDecay);

	// Intensity decay
	fVisibleIntensity *= (1.0f - fDeltaTime * fIntensityDecay);

	// Size decay
	float fSizeMultiplier = 1.0f - fDeltaTime * fSizeDecay;
	fSize *= fSizeMultiplier;
	fLength *= fSizeMultiplier;

	// Rotation delta
	fRotation += fDeltaTime * fRotationDelta;

	// Rotation delta decay
	float fRotationDeltaNew = fRotationDelta * (1.0f - fDeltaTime * fRotationDeltaDecay);

	// Write back modified fields
	particles.pParticles[i].f4Position = f4Position;
	particles.pParticles[i].f4Velocity = f4Velocity;
	particles.pParticles[i].fVisibleIntensity = fVisibleIntensity;
	particles.pParticles[i].fSize = fSize;
	particles.pParticles[i].fLength = fLength;
	particles.pParticles[i].fRotation = fRotation;
	particles.pParticles[i].fRotationDelta = fRotationDeltaNew;

	// If the particle hits the water or the intensity/size drops below epsilon, flag slot as free
	const float fSizeEpsilon = 0.01f;
	const float fIntensityEpsilon = 0.5f;
	if (fPreCollisionZ < 0.0f ||
	    fSize < fSizeEpsilon ||
		fVisibleIntensity < fIntensityEpsilon)
	{
	#if defined(ENABLE_32_BIT_BOOL)
		// Atomic — 32 neighbouring threads share this word, concurrent deallocations would race without it
		atomicAnd(particles.puiAllocated[i / 32], ~(1u << (uint(i) % 32u)));
	#else
		// Header declares pbAllocated as uint16_t; dead branch under ENABLE_32_BIT_BOOL but keep types reconciled
		particles.pbAllocated[i] = uint16_t(0);
	#endif

		// Update the lowest free index
		atomicMin(particles.iMinFreeIndex, i);
	}
}
