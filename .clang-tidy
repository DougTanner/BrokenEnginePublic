# Static analysis configuration for Broken Engine.
#
# Enabling in Visual Studio 2026:
#   Project Properties -> Code Analysis -> General
#     Enable Microsoft Code Analysis: Yes
#     Enable Clang-Tidy:              Yes
# Enable per project (BrokenEngineSandbox client/server, DataPacker) as desired;
# pre-existing code may produce warnings until a follow-up cleanup pass lands.
# WarningsAsErrors is empty by design.
#
# CLI:
#   clang-tidy <file.cpp> -- -std=c++23
#
# Style guide reference: Documents/C++StyleGuide.txt
#
# Deferred (re-enable in a future cleanup pass once the codebase is prepared):
#   misc-const-correctness          - high warning volume on existing locals
#   readability-identifier-naming   - cannot express Hungarian prefixes (rule 3)

Checks: >
  -*,
  bugprone-integer-division,
  bugprone-misplaced-widening-cast,
  bugprone-suspicious-memory-comparison,
  bugprone-unchecked-optional-access,
  bugprone-use-after-move,
  cppcoreguidelines-pro-type-cstyle-cast,
  cppcoreguidelines-slicing,
  google-build-using-namespace,
  llvm-prefer-defined,
  misc-static-assert,
  misc-unused-parameters,
  modernize-use-nullptr,
  modernize-use-override,
  modernize-use-using,
  performance-for-range-copy,
  performance-unnecessary-copy-initialization,
  performance-unnecessary-value-param,
  readability-implicit-bool-conversion,
  readability-uppercase-literal-suffix

WarningsAsErrors: ''
HeaderFilterRegex: '(Common|Engine|DataPacker|Projects)/.*\.(h|hpp)$'
FormatStyle: none

CheckOptions:
  readability-implicit-bool-conversion.AllowIntegerConditions: false
  readability-implicit-bool-conversion.AllowPointerConditions: false
